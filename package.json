  "version": "1.0.0",
  "description": "Pegatron GB300 NVL72 Offline Diagnostics Tool",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "package": "vite build && electron-packager . PegatronDiagnostics --platform=win32 --arch=x64 --out=dist_electron --overwrite"
