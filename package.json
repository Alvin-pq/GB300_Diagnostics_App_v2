    "electron-packager": "^17.1.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.pegatron.gb300.diagnostics",
    "productName": "Pegatron Diagnostics",
    "win": {
